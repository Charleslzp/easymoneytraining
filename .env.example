# Local Run19 finetune environment.
# Copy to .env and adjust paths/devices for the machine.

EASYMONEY_ROOT=/home/pythonuser/pythonproject/easymoney
BIGMODEL_ROOT=/home/pythonuser/pythonproject/bigmodel
PYTHON_BIN=/home/pythonuser/freqenv/bin/python
PYTHONPATH=/home/pythonuser/pythonproject/easymoney

# Local VPN proxy for exchange/HuggingFace access.
HTTP_PROXY=http://127.0.0.1:8080
HTTPS_PROXY=http://127.0.0.1:8080
ALL_PROXY=http://127.0.0.1:8080
http_proxy=http://127.0.0.1:8080
https_proxy=http://127.0.0.1:8080
all_proxy=http://127.0.0.1:8080
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

RUN19_BASE_CONFIG=training/configs/e2e_ppo_run19_finetune_from_best.json
RUN19_OUTPUT_DIR=checkpoints/ppo_e2e_run19_seq300_noasset_teacher_202607_u200
RUN19_RESOLVED_CONFIG=checkpoints/ppo_e2e_run19_seq300_noasset_teacher_202607_u200/config.resolved.json
RUN19_LOG_FILE=logs/train_run19_seq300_noasset_teacher_202607_u200.log

RUN19_DATA_FILE=/home/pythonuser/pythonproject/easymoney/data_4h/processed/crypto_sorted_full_history_4h_202607.parquet
RUN19_SOURCE_DATA_FILE=/home/pythonuser/pythonproject/bigmodel/data_4h/processed/crypto_sorted_full_history_4h.parquet
RUN19_UPDATE_END_DATE=2026-07-05
RUN19_UPDATE_WORKERS=8
RUN19_REPR_CACHE_DIR=/home/pythonuser/pythonproject/easymoney/data/cache/kron_repr_run19_seq300_202607
RUN19_CACHE_SPLITS=train,val,test
RUN19_REQUIRE_MIN_TIMESTAMP=2026-07-01
RUN19_TEACHER_ENABLED=1
RUN19_STRENGTH_CACHE_DIR=/home/pythonuser/pythonproject/easymoney/data/cache/kron_strength_run19_202607
RUN19_INIT_CHECKPOINT=/home/pythonuser/pythonproject/bigmodel/checkpoints/ppo_e2e_run19_sl15_valrandom/best.pt

RUN19_POLICY_DEVICE=cuda:0
RUN19_VALUE_DEVICE=cuda:0
RUN19_MAX_UPDATES=200
RUN19_SEQ_LENGTH=300
RUN19_USE_ASSET_IDS=0
RUN19_POLICY_LR=1e-05
RUN19_VALUE_LR=2.5e-05
RUN19_MINI_BATCH_SIZE=256
RUN19_VALUE_INFER_BATCH_SIZE=256
RUN19_PARALLEL_VALUE_POLICY_UPDATE=0

RUN19_BACKGROUND=1
